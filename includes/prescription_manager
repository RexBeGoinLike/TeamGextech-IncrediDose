function getPrescriptions($doctorid, $patientid) {
	global $db;
    $stmt = $db->prepare("SELECT * from Prescription WHERE doctorid = ?");
    $stmt->execute([$doctorid, $patientid]);
    $result = $stmt->get_result();
    $data = [];
    while ($row = $result->fetch_assoc()) {
    	$data[] = $row;
	}
	return $data;
}

